	<script>
		// helper: render Morris with given data
		function renderMorris(data) {
			// clear container
			document.getElementById('morris-extra-area').innerHTML = '';

			Morris.Area({
				element: 'morris-extra-area',
				data: data,
				xkey: 'period',
				ykeys: ['imports', 'exports', 'sbCount'],
				labels: ['Imports', 'Exports', 'SB Count'],
				lineColors: ['#7E81CB', '#fb9678', '#01C0C8'],
				pointSize: 2,
				lineWidth: 1,
				resize: true,
				fillOpacity: 0.6,
				behaveLikeLine: true,
				gridLineColor: '#eef0f2',
				hideHover: 'auto'
			});

			// update header totals if elements exist
			var totalImports = (data || []).reduce(function (acc, p) {return acc + (p.imports || 0);}, 0);
			var totalExports = (data || []).reduce(function (acc, p) {return acc + (p.exports || 0);}, 0);
			var elI = document.getElementById('total-imports');
			var elE = document.getElementById('total-exports');
			if (elI) elI.textContent = totalImports;
			if (elE) elE.textContent = totalExports;
		}

		// initial render using server-provided data
		renderMorris(initialChartData);

		// Hook the buttons to do client-side re-render using the same approach:
		document.getElementById('btn-week').addEventListener('click', function () {
			// you can call server again via redirect with ?range=week or implement ajax.
			// For simplicity, request a reload with the range parameter:
			location.href = updateQueryString(window.location.href, 'chartRange', 'week');
		});
		document.getElementById('btn-month').addEventListener('click', function () {
			location.href = updateQueryString(window.location.href, 'chartRange', 'month');
		});
		document.getElementById('btn-year').addEventListener('click', function () {
			location.href = updateQueryString(window.location.href, 'chartRange', 'year');
		});

		// small helper to update query string param (keeps existing params like fromDate/toDate)
		function updateQueryString(uri, key, value) {
			var re = new RegExp("([?&])" + key + "=.*?(&|$)", "i");
			var separator = uri.indexOf('?') !== -1 ? "&" : "?";
			if (uri.match(re)) {
				return uri.replace(re, '$1' + key + "=" + value + '$2');
			}
			else {
				return uri + separator + key + "=" + value;
			}
		}
	</script>

