        id1_0.assessable_value,
        id1_0.bcd,
        id1_0.bcd_rate,
        id1_0.be_date,
        id1_0.be_month,
        id1_0.be_no,
        id1_0.be_year,
        id1_0.claim_ref_no,
        id1_0.claim_year,
        id1_0.clientname,
        id1_0.closing_balance,
        id1_0.country_of_origin,
        id1_0.created_at,
        id1_0.dbk_part_no,
        id1_0.duty_claimed_amt,
        id1_0.igst,
        id1_0.igst_rate,
        id1_0.itchs_code,
        id1_0.item_description,
        id1_0.bom_part_no,
        id1_0.notn_eligibility,
        id1_0.notn_no,
        id1_0.port_code,
        id1_0.qty_opening_balance,
        id1_0.qty_used,
        id1_0.quantity,
        id1_0.stock_wise_eligibility,
        id1_0.supplier_name_address,
        id1_0.sws,
        id1_0.sws_rate,
        id1_0.total_duty,
        id1_0.uom,
        id1_0.updated_at 
    from
        tbl_import_data id1_0 
    where
        1=1 
        and id1_0.closing_balance>? 
        and not exists(select
