                on m3_0.bom_part_no=id2_0.bom_part_no, materials m4_0 
        where
            m4_0.bom_part_no=id1_0.bom_part_no 
            and m3_0.bom_part_no=m4_0.bom_part_no 
            and id2_0.alt_boe_part_no=id1_0.alt_boe_part_no 
            and id2_0.be_date<id1_0.be_date 
            and id2_0.closing_balance>?) 
    order by
        id1_0.be_date,
        id1_0.be_date desc 
    limit
        ?, ?
